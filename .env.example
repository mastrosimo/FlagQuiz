# Copia questo file come .env.local (già ignorato da git) e compila i valori
# da Supabase Dashboard → Project Settings → API.
# Vedi supabase/README.md per la procedura completa.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# NON aggiungere mai la service_role key qui: qualsiasi variabile con prefisso
# VITE_ finisce nel bundle JS pubblico servito al browser.
